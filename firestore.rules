rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. PROFESSORS: A professor can only read/write their own profile
    match /professors/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. CLASSES: Secured by the `professorId` field
    match /classes/{classId} {
      allow read, update, delete: if isAuthenticated() && resource.data.professorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.professorId == request.auth.uid;
    }

    // 3. SECTIONS: A section belongs to a class. We verify the professor owns the parent class.
    match /sections/{sectionId} {
      function ownsClass(classId) {
        return get(/databases/$(database)/documents/classes/$(classId)).data.professorId == request.auth.uid;
      }
      
      allow read, update, delete: if isAuthenticated() && ownsClass(resource.data.classId);
      allow create: if isAuthenticated() && ownsClass(request.resource.data.classId);
    }

    // 4. STUDENTS: Secured by the `professorId` field
    match /students/{studentId} {
      allow read, update, delete: if isAuthenticated() && resource.data.professorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.professorId == request.auth.uid;
    }

    // 5. ATTENDANCE RECORDS: Belongs to a section. We verify the professor owns the class the section belongs to.
    match /attendance_records/{recordId} {
      function ownsSection(sectionId) {
        let classId = get(/databases/$(database)/documents/sections/$(sectionId)).data.classId;
        return get(/databases/$(database)/documents/classes/$(classId)).data.professorId == request.auth.uid;
      }

      allow read, update, delete: if isAuthenticated() && ownsSection(resource.data.sectionId);
      allow create: if isAuthenticated() && ownsSection(request.resource.data.sectionId);
    }
  }
}
